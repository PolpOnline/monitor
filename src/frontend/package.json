		"tslib": "^2.8.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.64.0",
		"unplugin-fonts": "^2.0.0",
		"unplugin-icons": "^23.0.1",
		"vite": "^8.1.5",
		"vite-plugin-devtools-json": "^1.0.0",
