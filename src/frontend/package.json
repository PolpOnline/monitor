		"@iconify-json/ph": "^1.2.2",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.25.0",
		"@prgm/sveltekit-progress-bar": "^3.0.2",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@sveltejs/vite-plugin-svelte-inspector": "^5.0.2",
