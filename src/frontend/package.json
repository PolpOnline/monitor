		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.73.0",
		"@prgm/sveltekit-progress-bar": "^3.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
