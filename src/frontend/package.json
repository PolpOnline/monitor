		"eslint-plugin-svelte": "^3.22.0",
		"formsnap": "2.0.1",
		"globals": "^17.7.0",
		"lucide-svelte": "^1.0.1",
		"mode-watcher": "^1.1.0",
		"openapi-fetch": "^0.17.0",
		"openapi-typescript": "^7.13.0",
		"postcss": "^8.5.20",
